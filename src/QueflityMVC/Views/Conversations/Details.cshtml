@using QueflityMVC.Domain.Interfaces
@model QueflityMVC.Application.ViewModels.Message.ConversationVm
@inject IUserContext UserContext

@{
    ViewData["Title"] = "Chat";
}

@section Styles{
    <style>
    .conversation-wrapper {
        display: flex;
        flex: 1;
        flex-direction: column;
        height: 100%;
    }

    .top-bar {
        background-color: #f8f9fa;
        padding: 10px;
        border-bottom: 1px solid #dee2e6;
    }

    .top-bar h4 {
        margin-left: 20px;
    }

    .main-content {
        display: flex;
        flex: 1;
        overflow: hidden;
    }

    .left-panel {
        background-color: #f8f9fa;
        padding: 15px;
        border-right: 1px solid #dee2e6;
        overflow-y: auto;
        flex: 0 0 25%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    /* Center content and style adjustments */
    .product-info {
        text-align: center;
        margin-bottom: 20px;
    }

    .product-image {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
    }

    .product-name {
        font-weight: bold;
        margin-top: 15px;
    }

    .product-price {
        font-size: 18px;
        color: #6c757d;
        margin-top: 5px;
    }

    .last-message-info {
        margin-top: 20px;
        font-size: 14px;
        color: #6c757d;
    }

    .last-message-info p {
        margin: 0;
    }

    /* Hide the left panel on small screens (below 768px) */
    @@media (max-width: 768px) {
    .left-panel {
        display: none;  /* Hide on small screens */
    }
    }

    .right-panel {
        padding: 15px;
        display: flex;
        flex-direction: column;
        flex: 1;
        overflow: hidden;
    }

    .message-space {
        flex: 1;
        display: flex;
        flex-direction: column;
        margin-bottom: 20px;
        overflow: auto;
    }

    #connection-status {
        -webkit-user-select: none; /* Safari */
        -ms-user-select: none; /* IE 10 and IE 11 */
        user-select: none; /* Standard syntax */
    }
</style>

    <link href="@Url.Content("~/css/messages.css")" rel="stylesheet" type="text/css"/>
}

@* ReSharper disable once Html.AttributesQuotes *@
<input type="hidden" id="messagesData" value='@Json.Serialize(Model.Messages)'/>

<div class="conversation-wrapper">
    <div class="row">
        <div class="col-12 top-bar">
            <h4>
                @Model.Title
                <span class="badge" id="connection-status" onclick="tryReconnect()"></span>
            </h4>
        </div>
    </div>
    <div class="main-content">
        <div class="left-panel d-none d-md-block" id="leftPanel">
            <!-- Hide on small screens -->
            <div class="product-info text-center mb-3">
                <img src="@Model.Product.Image.FileUrl" alt="@Model.Product.Image.AltDescription" class="img-thumbnail product-image"/>
                <h5 class="mt-3 product-name">@Model.Product.Name</h5>
                <p class="product-price text-muted">Price: $@Model.Product.Price</p>
            </div>
            <div class="last-message-info">
                @if (Model.Messages.LastOrDefault() is { } lastMessageVm)
                {
                    <p class="text-muted">Last message: <span class="fw-bold">@lastMessageVm.SentAt.ToShortDateString()</span></p>
                }
                else
                {
                    <p class="text-muted">No messages yet</p>
                }
            </div>
        </div>

        <div class="right-panel">
            <div class="message-space px-2">
                <div class="messages-container" id="messagesList">
                </div>
            </div>

            <div class="input-group" id="send-message-panel">
                <input type="text" class="form-control" placeholder="Type your message here..." id="newMessageContent">
                <div class="input-group-append">
                    <button class="btn btn-primary" type="button" id="sendMessageButton" onclick="sendMessage()">Send</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Connection refused modal -->
<div class="modal fade" id="connectionRefusedModal" tabindex="-1" aria-labelledby="connectionRefusedByServerModal"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fs-5">Connection to the server was refused</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Server refused connection. Please reload the page or try to connect by clicking the "Disconnected"
                badge.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="window.location.reload()">Reload</button>
            </div>
        </div>
    </div>
</div>

<!-- Disconnected modal -->
<div class="modal fade" id="disconnectedModal" tabindex="-1" aria-labelledby="appDisconnectedModal" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fs-5">Disconnected from the server</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Application is disconnected from the server. Please reload the page or try to connect by clicking the
                "Disconnected" badge.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal" onclick="connectToServer()">
                    Try to
                    connect
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Cannot connect modal -->
<div class="modal fade" id="cannotConnectModal" tabindex="-1" aria-labelledby="cannotConnectToServerModal"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fs-5">Could not connect to the server</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Application could not connect to the server. Please reload the page or try to connect by clicking the
                "Cannot Connect" badge.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal" onclick="connectToServer()">
                    Try to
                    connect
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/js/signalr/dist/browser/signalr.js"></script>
    <script src="~/js/messages.js"></script>

    <script>
    const ConnectionStatus = {
        Connected: 'Connected',
        Disconnected: 'Disconnected',
        Connecting: 'Connecting',
        Refused: 'Refused',
        CannotConnect: 'CannotConnect'
    };

    var connectionStatus = ConnectionStatus.Disconnected;
    var connection = undefined;
    
    document.addEventListener("DOMContentLoaded", () => {
        // Bind ENTER key to send message
        const messageInput = document.getElementById("newMessageContent");
        messageInput.addEventListener("keypress", function (event) {
            if (event.key === "Enter") {
                event.preventDefault();
                document.getElementById("sendMessageButton").click();
            }
        }); 
    
    
        const messagesData = document.getElementById("messagesData").value;
        const messages = JSON.parse(messagesData);
        const currentUserId = "@UserContext.UserId";
        renderMessages(messages, currentUserId);

        try {
            connectToServer();
        } catch (error) {
            console.error("Error connecting to server");
            console.error(error.toString());
            setConnectionStatus(ConnectionStatus.CannotConnect);
            $('#cannotConnectModal').modal('show');
            toggleMessageInput(false);
        }
        });

    // Function to render messages from JSON data
    function renderMessages(messages, currentUserId) {
        messages.forEach(message => {
            const messageDiv = createMessageDiv(message, currentUserId);
            $('#messagesList').append(messageDiv);
        });
        $('.message-space').scrollTop = $('.message-space').scrollHeight;
    }

        // Function to set the connection status
        function setConnectionStatus(status) {
            connectionStatus = status;

            const connectionStatusBadge = document.getElementById('connection-status');
            // Remove existing badge color classes
            connectionStatusBadge.classList.remove('bg-primary', 'bg-secondary', 'bg-success', 'bg-danger', 'bg-warning', 'bg-info', 'bg-light', 'bg-dark');

            toggleMessageInput(status === ConnectionStatus.Connected); // Enable input if connected

            // Update status text and badge class based on status
            switch (status) {
                case ConnectionStatus.Connected:
                    connectionStatusBadge.innerText = 'Connected';
                    connectionStatusBadge.classList.add('bg-success'); // Green badge for connected
                    break;
                case ConnectionStatus.Disconnected:
                    connectionStatusBadge.innerText = 'Disconnected';
                    connectionStatusBadge.classList.add('bg-danger'); // Red badge for disconnected
                    break;
                case ConnectionStatus.Connecting:
                    connectionStatusBadge.innerText = 'Connecting...';
                    connectionStatusBadge.classList.add('bg-warning'); // Yellow badge for Connecting
                    break;
                case ConnectionStatus.Refused:
                    connectionStatusBadge.innerText = 'Connection Refused';
                    connectionStatusBadge.classList.add('bg-dark'); // Dark badge for refused
                    break;
                case ConnectionStatus.CannotConnect:
                    connectionStatusBadge.innerText = 'Cannot Connect';
                    connectionStatusBadge.classList.add('bg-danger'); // Red badge for cannot connect
                    break;
                default:
                    connectionStatusBadge.innerText = '';
                    connectionStatusBadge.classList.add('bg-secondary'); // Grey badge for unknown status
            }
        }

        function tryReconnect() {
            if (connectionStatus === ConnectionStatus.Disconnected) {
                connectToServer();
            }
        }

        // If send message should be available
        function toggleMessageInput(isEnabled) {
            const messageInput = document.getElementById('newMessageContent');
            messageInput.disabled =! isEnabled;

            const sendMessageButton = document.getElementById('sendMessageButton');
            sendMessageButton.disabled =! isEnabled;
        }

    function connectToServer() {
        toggleMessageInput(false); // Disable input while connecting
        setConnectionStatus(ConnectionStatus.Connecting);
        // Configure connection with server.
        connection = new signalR.HubConnectionBuilder()
            .withUrl("/messageHub", {
                transport: signalR.HttpTransportType.LongPolling | signalR.HttpTransportType.ServerSentEvents,
            })
            .withAutomaticReconnect([0, 3000, 5000, 10000])
            .configureLogging(signalR.LogLevel.Error)
            .build();
        
        // Bind new message behavior.
        connection.on("ReceiveMessage", message => {
            console.log("Received message.");
            const msg = createMessageDiv(message, "@UserContext.UserId");
            $('#messagesList').append(msg);
        });

        connection.onreconnecting(error => {
            console.log("Reconnecting...");
            setConnectionStatus(ConnectionStatus.Connecting); // Update status to connecting
        });

        connection.onreconnected(connectionId => {
            console.log("Connection successfully reconnected.");
            setConnectionStatus(ConnectionStatus.Connected); // Update status to connected
        });

        connection.onclose(async error => {
            setConnectionStatus(ConnectionStatus.Disconnected);
            
            if (error) {
                console.error("Connection closed with error: " + error);
            } else {
                console.log("Connection closed.");
                return;
            }

            // Show modal if the connection is closed due to unauthorized access
            if (error && error.statusCode === 401) {
                setConnectionStatus(ConnectionStatus.Refused);
                $('#connectionRefusedModal').modal('show');
                return;
            }

            $('#disconnectedModal').modal('show');
        });


        // Start connection and listen to conversation.
        connection.start().then(() => {
            setConnectionStatus(ConnectionStatus.Connected);
            const conversationId = @Model.Id;
            connection.invoke("JoinGroup", conversationId).catch(err => console.error(err.toString()));
        })
            .catch(err => {
                console.error("Error connecting to server");
                console.error(err.toString());
                setConnectionStatus(ConnectionStatus.CannotConnect);
                $('#cannotConnectModal').modal('show');
            });
    }
    
    function sendMessage(){
        if (connectionStatus !== ConnectionStatus.Connected) {
            tryReconnect();
            return;
        }

        const content = $('#newMessageContent').val();
        if (content) {
            toggleMessageInput(false); // Disable input while sending
            const conversationId = @Model.Id; // Replace with actual conversation ID
            if (!connection || connectionStatus !== ConnectionStatus.Connected) {
                console.error("Cannot send message while disconnected.");
                return;
            }
            connection.invoke("SendMessageToGroup", conversationId, content).then(() => {
                $('#newMessageContent').val(''); // Clear the input field after sending
                toggleMessageInput(true);
            }).catch(err => console.error(err.toString()));
        }
        }
</script>
}