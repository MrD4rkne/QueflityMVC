@{
    ViewData["Title"] = "Privacy Policy";
}
<h1>@ViewData["Title"]</h1>

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/privacy.css")" asp-append-version="true"/>
}

<div id="privacy">

</div>

@section Scripts {
    <script>
    $(function () {
        $("#privacy").load("@Url.Content("~/privacy.html")");
    });
</script>
}