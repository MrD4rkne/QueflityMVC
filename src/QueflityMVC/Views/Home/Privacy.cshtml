@using Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Privacy Policy";
}
<h1>@ViewData["Title"]</h1>

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/privacy.css")" asp-append-version="true"/>
}

<div id="privacy-policy-container">

</div>

@section Scripts {
    <script>
    $(function () {
        $("#privacy-policy-container").load("@Url.Content("~/privacy.html")");
    });
</script>
}