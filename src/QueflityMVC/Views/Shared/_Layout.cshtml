@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.Extensions.Options
@using QueflityMVC.Application.Constants
@using QueflityMVC.Web.Setup.Other
@inject IAuthorizationService AuthorizationService
@inject IOptions<BrandOptions> BrandOptions

@{
    bool canSeeAdminPage = (await AuthorizationService.AuthorizeAsync(User, Policies.SEE_ADMIN_PANEL)).Succeeded;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - @BrandOptions.Value.Name</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>

    @await RenderSectionAsync("Styles", false)
</head>
<body>
<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="@Url.Action("Index", "Home", new { area = "" })">@BrandOptions.Value.Name</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse justify-content-between" id="navbarNav">
            <!-- Left-aligned links -->
            <ul class="navbar-nav me-auto">
            </ul>

            <!-- Centered links -->
            <ul class="navbar-nav mx-auto">
                @if (canSeeAdminPage)
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-area="Admin" asp-controller="Home" asp-action="Index">Admin</a>
                    </li>
                }
            </ul>

            <!-- Right-aligned login partial -->
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <partial name="_LoginPartial"/>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="main-content">
    @RenderBody()
</div>

<footer class="bg-dark text-white text-center py-3">
    <p>&copy; @DateTime.Now.Year - @BrandOptions.Value.Name - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></p>
</footer>

<!-- Scripts -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", false)
</body>
</html>