@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.Extensions.Options
@using QueflityMVC.Application.Constants
@using QueflityMVC.Web.Setup
@inject IAuthorizationService AuthorizationService
@inject IOptions<BrandOptions> BrandOptions

@{
    bool canSeeAdminPage = (await AuthorizationService.AuthorizeAsync(User, Policies.SEE_ADMIN_PANEL)).Succeeded;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - @BrandOptions.Value.Name</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css"/>

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>

    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"/>

    <!-- Google Fonts for better typography -->
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

    @await RenderSectionAsync("Styles", false)

    <!-- Scripts -->
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", false)
</head>
<body>
<!-- Navbar -->
<nav class="navbar navbar-expand-md navbar-dark bg-primary shadow-sm main-navbar">
    <div class="container-fluid">
        <!-- Brand -->
        <a class="navbar-brand d-flex align-items-center" asp-action="Index" asp-controller="Home" asp-area="">
            <img src="@BrandOptions.Value.LogoUrl" style="height: 40px; width: auto;" alt="Logo :)"/>
            <span class="ms-2">@BrandOptions.Value.Name</span>
        </a>

        <!-- Toggler Button -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navbar Links -->
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav mx-auto">
                @if (canSeeAdminPage)
                {
                    <li class="nav-item">
                        <a class="nav-link btn text-light fw-bold" asp-action="Index" asp-controller="Home"
                           asp-area="Admin">
                            <i class="fas fa-cog me-1"></i> Admin
                        </a>
                    </li>
                }
            </ul>

            <!-- Right-aligned Login Partial -->
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <partial name="_LoginPartial"/>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="main-content">
    @RenderBody()
</div>

<partial name="_CookieConsentPartial"/>

<footer class="text-center py-4 mt-auto shadow-lg">
    <div class="d-flex align-items-center">
        <p class="me-3">&copy; @DateTime.Now.Year - @BrandOptions.Value.Name</p>
        <partial name="_CookieFooterPartial"/>
    </div>
</footer>

</body>
</html>