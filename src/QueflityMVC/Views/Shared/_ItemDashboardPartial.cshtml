@model QueflityMVC.Application.ViewModels.Product.ItemForCardVm

<style>
    .rectangle {
        padding: 15px;
        color: white;
        text-align: center;
        margin: 5px;
        border-radius: 5px;
    }

    .card {
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .card-img-top {
        border-top-left-radius: 8px;
        border-top-right-radius: 8px;
    }

    .modal-header {
        border-bottom: none;
    }
</style>

<div class="card h-100 w-100">
    <!-- Product image-->
    <img class="card-img-top" src="@Model.Image.FileUrl" alt="@Model.Image.AltDescription">
    <!-- Product details-->
    <div class="card-body p-4">
        <div class="text-center">
            <!-- Product name-->
            <h5 class="fw-bolder">@Model.Name</h5>
            <!-- Product price-->
            <p class="text-success font-italic">@Model.Price</p>
            <!-- Product category-->
            <p class="fst-italic">@Model.Category.Name</p>
        </div>
    </div>
    <!-- Product actions-->
    <div class="card-footer p-4 pt-0 border-top-0 bg-transparent">
        <div class="row">
            <div class="btn-group" role="group">
                <button type="button" class="btn btn-outline-dark mt-auto" data-bs-toggle="modal"
                        data-bs-target="@($"#itemComponents{Model.Id}")">
                    <i class="fas fa-cogs"></i> Components
                </button>
                @Html.ActionLink("Contact about", "Contact", "Home", new { id = Model.Id }, new { @class = "btn btn-outline-primary" })
            </div>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="@($"itemComponents{Model.Id}")" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="modalLabel">Components of @Model.Name</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (Model.Components is { Count: > 0 })
                    {
                        <div class="container mt-3">
                            <div class="d-flex flex-wrap">
                                @foreach (var component in Model.Components)
                                {
                                    <div class="rectangle">
                                        <i class="fas fa-puzzle-piece"></i> @component.Name
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center">No components found</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Function to generate a random color
    function getRandomColor() {
        const letters = '0123456789ABCDEF';
        let color = '#';
        for (let i = 0; i < 6; i++) {
            color += letters[Math.floor(Math.random() * 16)];
        }
        return color;
    }

    // Apply random colors to each rectangle
    document.querySelectorAll('.rectangle').forEach(rectangle => {
        rectangle.style.backgroundColor = getRandomColor();
    });
</script>