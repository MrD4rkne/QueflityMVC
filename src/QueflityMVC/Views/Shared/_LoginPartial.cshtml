@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using QueflityMVC.Domain.Models
@inject SignInManager<ApplicationUser> SignInManager

<style>
    .manage-link {
        transition: transform 0.3s ease, background-color 0.3s ease;
    }

    .manage-link:hover {
        transform: scale(1.05);
    }
</style>

<ul class="navbar-nav align-items-center">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item me-3">
            <a class="nav-link text-light fw-bold" asp-controller="Conversations" asp-action="Index">
                <i class="fas fa-comments me-1"></i>Conversations
            </a>
        </li>
        <li class="nav-item me-3">
            <a class="nav-link manage-link text-light fw-bold bg-secondary px-3 py-2 rounded"
               asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage"
               style="border: 1px solid #fff;">
                <i class="fa-solid fa-user me-1"></i> @User.Identity?.Name
            </a>
        </li>
        <li class="nav-item me-3 d-flex align-items-center">
            <form class="d-inline m-0" asp-area="Identity" asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="nav-link btn btn-link text-light fw-bold p-0 d-flex align-items-center">
                    <i class="fas fa-sign-out-alt me-1"></i>Logout
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-light fw-bold" asp-area="Identity" asp-page="/Account/Register">
                <i class="fas fa-user-plus me-1"></i>Register
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-light fw-bold" asp-area="Identity" asp-page="/Account/Login">
                <i class="fas fa-sign-in-alt me-1"></i>Login
            </a>
        </li>
    }
</ul>