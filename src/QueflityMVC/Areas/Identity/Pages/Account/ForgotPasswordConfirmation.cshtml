@page
@using Newtonsoft.Json
@using QueflityMVC.Web.Areas.Identity.Pages.Account
@model QueflityMVC.Web.Areas.Identity.Pages.Account.ForgotPasswordConfirmation
@{
    ViewData["PopupVm"] = JsonConvert.SerializeObject(new PopUpViewModel
    {
        Title = "Forgot password confirmation",
        Message = "Please check your email to reset your password.",
        Type = PopUpType.Info
    });
    Response.Redirect(Url.Page("/Account/Login"));
}