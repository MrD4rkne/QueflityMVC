@page
@using Newtonsoft.Json
@using QueflityMVC.Web.Areas.Identity.Pages.Account
@model QueflityMVC.Web.Areas.Identity.Pages.Account.ResetPasswordConfirmationModel
@{
    TempData["PopupVm"] = JsonConvert.SerializeObject(new PopUpViewModel
    {
        Title = "Reset password confirmation",
        Message = "Your password has been reset. Please click here to log in.",
        Type = PopUpType.Info
    });
    Response.Redirect(Url.Page("/Account/Login"));
}