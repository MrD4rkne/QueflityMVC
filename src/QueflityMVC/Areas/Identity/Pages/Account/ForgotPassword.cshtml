@page
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model QueflityMVC.Web.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<h1>@ViewData["Title"]</h1>
<h2>Please enter your email.</h2>
<hr/>
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="form-floating mb-3">
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true"
               placeholder="name@example.com"/>
        <label asp-for="Input.Email" class="form-label"><i class="fas fa-envelope"></i> Email</label>
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <button type="submit" class="w-100 btn btn-lg btn-primary">Send reset link</button>
</form>