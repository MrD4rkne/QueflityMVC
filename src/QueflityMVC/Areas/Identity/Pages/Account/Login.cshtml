@page
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model QueflityMVC.Web.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Log in";
}

@section Styles{
    <style>
    .log-in-wrapper h1 {
        font-size: 2rem;
        margin-bottom: 1.5rem;
        color: #333;
    }

    .log-in-wrapper section {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%;
    }

    .log-in-wrapper form {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        flex-grow: 1;
    }

    .log-in-wrapper .form-floating-label {
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .log-in-wrapper .form-floating {
        margin-bottom: 1rem;
    }

    .form-control {
        border-radius: 0.375rem;
        padding: 0.75rem;
        font-size: 1rem;
    }

    .form-control:focus {
        box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
        border-color: #007bff;
    }

    .checkbox label {
        font-weight: 400;
    }
</style>
}

<div class="log-in-wrapper">
    <h1>
        <i class="fas fa-sign-in-alt"></i> @ViewData["Title"]
    </h1>
    <section>
        <form id="account" method="post">
            <div>
                <h2 class="form-floating-label">Use an account to log in.</h2>
                <hr/>
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true"
                           placeholder="name@example.com"/>
                    <label asp-for="Input.Email" class="form-label"><i class="fas fa-envelope"></i> Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password"
                           aria-required="true" placeholder="password"/>
                    <label asp-for="Input.Password" class="form-label"><i class="fas fa-lock"></i> Password</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="checkbox mb-3">
                    <label asp-for="Input.RememberMe" class="form-label">
                        <input class="form-check-input" asp-for="Input.RememberMe"/>
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>
                <div>
                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">
                        <i class="fas fa-sign-in-alt"></i> Log in
                    </button>
                </div>
            </div>
            <div class="mt-3">
                <p>
                    <a id="forgot-password" class="btn btn-social" asp-page="./ForgotPassword">
                        <i
                            class="fas fa-key">
                        </i> Forgot your password?
                    </a>
                </p>
                <p>
                    <a class="btn btn-social" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">
                        <i
                            class="fas fa-user-plus">
                        </i> Register as a new user
                    </a>
                </p>
                <p>
                    <a id="resend-confirmation" class="btn btn-social" asp-page="./ResendEmailConfirmation">
                        <i
                            class="fas fa-envelope-open">
                        </i> Resend email confirmation
                    </a>
                </p>
            </div>
        </form>
    </section>
    @if (Model.ExternalLogins is { Count: > 0 })
    {
        <section class="mt-4">
            <h3><i class="fas fa-external-link-alt"></i> Use another service to log in.</h3>

            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post"
                  class="form-horizontal">
                <div>
                    <p>
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit" class="btn btn-social" name="provider" value="@provider.Name"
                                    title="Log in using your @provider.DisplayName account">
                                @provider.DisplayName
                            </button>
                        }
                    </p>
                </div>
            </form>
        </section>
    }
</div>