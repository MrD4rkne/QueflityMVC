@page
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model QueflityMVC.Web.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

@section Styles{
    <style>
    .register-wrapper h1 {
        font-size: 2rem;
        color: #333;
    }

    .register-wrapper h2 {
        font-size: 1.75rem;
        color: #333;
    }

    .register-wrapper section {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%;
    }

    .register-wrapper form {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        flex-grow: 1;
    }

    .register-wrapper .form-floating-label {
        font-weight: 600;
        margin-bottom: 1rem;
    }

    .register-wrapper .form-floating {
        margin-bottom: 1rem;
    }

    .form-control {
        border-radius: 0.375rem;
        padding: 0.75rem;
        font-size: 1rem;
    }

    .form-control:focus {
        box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);
        border-color: #007bff;
    }

    .btn-social {
        display: flex;
        align-items: center;
        justify-content: center;
        background: #ffffff;
        border: 1px solid #ddd;
        border-radius: 0.375rem;
        padding: 0.5rem 1rem;
        margin-bottom: 0.5rem;
        font-size: 1rem;
        transition: background-color 0.3s, border-color 0.3s;
    }

    .btn-social:hover {
        background-color: #f8f9fa;
        border-color: #ccc;
    }

    .btn-social i {
        margin-right: 0.5rem;
    }

    .checkbox label {
        font-weight: 400;
    }
</style>
}

<div class="register-wrapper">
    <h1>@ViewData["Title"]</h1>

    <section>
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <h2>Create a new account.</h2>
            <hr/>
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true"
                       placeholder="name@example.com"/>
                <label asp-for="Input.Email" class="form-label"><i class="fas fa-envelope"></i> Email</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true"
                       placeholder="password"/>
                <label asp-for="Input.Password" class="form-label"><i class="fas fa-lock"></i> Password</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password"
                       aria-required="true" placeholder="password"/>
                <label asp-for="Input.ConfirmPassword" class="form-label">
                    <i class="fas fa-lock"></i> Confirm
                    Password
                </label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Register</button>
        </form>
    </section>

    <div class="mt-3">
        <p>
            <a id="forgot-password" class="btn btn-social" asp-page="./Login">
                <i class="fas fa-sign-in-alt"></i> Already have an account? Log in
            </a>
        </p>
    </div>

    @if (Model.ExternalLogins is { Count: > 0 })
    {
        <section class="mt-4">
            <h3>Use another service to register.</h3>
            <hr/>
            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post"
                  class="form-horizontal">
                <div>
                    <p>
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit" class="btn btn-primary" name="provider" value="@provider.Name"
                                    title="Log in using your @provider.DisplayName account">
                                @provider.DisplayName
                            </button>
                        }
                    </p>
                </div>
            </form>
        </section>
    }
</div>