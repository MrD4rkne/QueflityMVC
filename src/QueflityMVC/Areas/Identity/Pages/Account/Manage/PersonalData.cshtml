@page
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using QueflityMVC.Web.Areas.Identity.Pages.Account.Manage
@model QueflityMVC.Web.Areas.Identity.Pages.Account.Manage.PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

@section Styles {
    <style>
    .page-title {
        font-size: 1.75rem;
        color: #007bff;
        margin-bottom: 1rem;
        text-align: center;
    }

    .description {
        margin-bottom: 1rem;
        font-size: 1rem;
        color: #212529;
    }

    .important {
        font-weight: bold;
        color: #dc3545;
        margin-bottom: 1rem;
    }

    .btn-custom {
        border-radius: 0.25rem;
        padding: 0.75rem 1.25rem;
        font-size: 1rem;
        width: 100%;
    }

    .btn-download {
        background-color: #007bff;
        border-color: #007bff;
        color: #fff;
    }

    .btn-delete {
        background-color: #dc3545;
        border-color: #dc3545;
        color: #fff;
    }

    .btn-custom i {
        margin-right: 0.5rem;
    }
</style>
}

<div class="container-custom mt-5">
    <h3 class="page-title">
        <i class="fas fa-user-circle"></i> @ViewData["Title"]
    </h3>

    <div class="description">
        Your account contains personal data that you have given us. This page allows you to download or delete that
        data.
    </div>
    <div class="important">
        <strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
    </div>

    <form id="download-data" asp-page="DownloadPersonalData" method="post">
        <button class="btn btn-custom btn-download" type="submit">
            <i class="fas fa-download"></i> Download Data
        </button>
    </form>

    <div class="mt-3">
        <a id="delete" asp-page="DeletePersonalData" class="btn btn-custom btn-delete">
            <i class="fas fa-trash-alt"></i> Delete Account
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}