@page
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using QueflityMVC.Web.Areas.Identity.Pages.Account.Manage
@model QueflityMVC.Web.Areas.Identity.Pages.Account.Manage.EmailModel
@{
    ViewData["Title"] = "Manage Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<h3 class="text-primary mb-4">
    <i class="fas fa-envelope"></i> @ViewData["Title"]
</h3>

<form id="email-form" method="post">
    <div asp-validation-summary="All" class="text-danger mb-4" role="alert"></div>

    @if (Model.IsEmailConfirmed)
    {
        <div class="form-floating mb-3 input-group">
            <input asp-for="Email" class="form-control" placeholder="Your current email" disabled/>
            <div class="input-group-append">
                <span class="h-100 input-group-text text-success font-weight-bold">
                    <i class="fas fa-check"></i>
                </span>
            </div>
            <label asp-for="Email" class="form-label"><i class="fas fa-envelope"></i> Current Email</label>
        </div>
    }
    else
    {
        <div class="form-floating mb-3">
            <input asp-for="Email" class="form-control" placeholder="Your current email" disabled/>
            <label asp-for="Email" class="form-label"><i class="fas fa-envelope"></i> Current Email</label>
            <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail"
                    class="btn btn-link text-primary">
                <i class="fas fa-paper-plane"></i> Send Verification Email
            </button>
        </div>
    }

    <div class="form-floating mb-3">
        <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true"
               placeholder="Enter your new email"/>
        <label asp-for="Input.NewEmail" class="form-label"><i class="fas fa-envelope-open-text"></i> New Email</label>
        <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
    </div>

    <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail"
            class="w-100 btn btn-lg btn-primary">
        <i class="fas fa-sync-alt"></i> Change Email
    </button>
</form>