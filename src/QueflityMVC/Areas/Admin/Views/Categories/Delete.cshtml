@using Microsoft.AspNetCore.Mvc.TagHelpers
@model QueflityMVC.Application.ViewModels.Category.DeleteFailedCategoryVm

@{
    ViewData["Title"] = "Deletion failed";
}

<h1>Delete</h1>

<div>
    <h4>@Model.Message</h4>
    <hr/>
</div>
<div>
    @Html.ActionLink("View items with this category", "ViewItems", "Categories", new { area = "Admin", id = Model.CategoryId })
    |
    <a asp-action="Index" asp-controller="Categories" asp-area="Admin">Back to List</a>
</div>