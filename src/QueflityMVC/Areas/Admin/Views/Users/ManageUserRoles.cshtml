@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using QueflityMVC.Application.Constants
@model QueflityMVC.Application.ViewModels.User.UserRolesVm
@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = $"{Model.Username} - Roles";
    bool canListUsers = (await AuthorizationService.AuthorizeAsync(User, Policies.USERS_LIST)).Succeeded;
}

<div class="container-fluid p-4">

    @if (canListUsers)
    {
        <div class="mb-3">
            <a asp-action="Index" asp-controller="Users" asp-area="Admin" class="btn btn-outline-primary">
                <i class="fas fa-arrow-left"></i> Back to Users
            </a>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            @Model.Username
            @if (Model.IsEnabled)
            {
                <span class="badge bg-success">Active</span>
            }
            else
            {
                <span class="badge bg-secondary">Disabled</span>
            }
        </h2>
        @if (Model.CanCallerManage)
        {
            <button type="submit" class="btn btn-primary" form="userRolesForm">
                <i class="fas fa-save"></i> Save Changes
            </button>
        }
    </div>

    <form asp-action="ManageUserRoles" asp-controller="Users" asp-area="Admin" id="userRolesForm">
        <div class="row">
            @Html.HiddenFor(vm => vm.UserId)
            <table class="table table-hover">
                <thead class="table-dark">
                <tr>
                    <th scope="col">Role Name</th>
                    <th scope="col" class="text-center">Assigned</th>
                </tr>
                </thead>
                <tbody>
                @for (var i = 0; i < Model.AllRoles.Count; i++)
                {
                    var role = Model.AllRoles[i];
                    role.IsSelected = Model.AssignedRolesNames.Contains(role.Name);
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => role.Name)
                        </td>
                        <td class="text-center">
                            @Html.HiddenFor(vm => vm.AllRoles[i].Id)
                            @if (Model.CanCallerManage)
                            {
                                <div class="form-check form-switch d-inline-block">
                                    @Html.CheckBoxFor(vm => vm.AllRoles[i].IsSelected, new { @class = "form-check-input" })
                                </div>
                            }
                            else
                            {
                                <div class="form-check form-switch d-inline-block">
                                    @Html.CheckBoxFor(vm => vm.AllRoles[i].IsSelected, new { @class = "form-check-input", disabled = "disabled" })
                                </div>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </form>
</div>