@inject IAuthorizationService AuthorizationService
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using QueflityMVC.Application.Constants
@model QueflityMVC.Application.ViewModels.Element.ElementVm

@{
    ViewData["Title"] = "Add Item to Kit";
    bool canListEntities = (await AuthorizationService.AuthorizeAsync(User, Policies.ENTITIES_LIST)).Succeeded;
}

@if (canListEntities)
{
    <div class="mb-3 d-flex align-items-center">
        <!-- Button Group -->
        <div class="btn-group" role="group">
            <!-- Arrow Icon -->
            <a asp-action="Index" asp-controller="Kits" asp-area="Admin" class="btn btn-primary">
                Back to List
            </a>
            <a asp-action="Details" asp-controller="Kits" asp-area="Admin" asp-route-id="@Model.KitDetailsVm.Id"
               class="btn btn-secondary">
                Details
            </a>
        </div>
    </div>
}

<h1>Create Membership</h1>
<h4>Add an item to your set!</h4>
<hr/>

<form asp-action="AddComponent" asp-controller="Kits" asp-area="Admin">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row">
        <div class="col-md">
            <h4>Set</h4>
            <partial name="_KitDetailsPartial" model="@Model.KitDetailsVm"/>
            @Html.HiddenFor(model => model.KitDetailsVm.Id)
            @Html.HiddenFor(model => model.KitDetailsVm.Price)
            @Html.HiddenFor(model => model.KitDetailsVm.ShouldBeShown)
            @Html.HiddenFor(model => model.KitDetailsVm.Name)
            @Html.HiddenFor(model => model.KitDetailsVm!.Image!.Id)
            @Html.HiddenFor(model => model.KitDetailsVm!.Image!.AltDescription)
            @Html.HiddenFor(model => model.KitDetailsVm!.Image!.FileUrl)
        </div>
        <div class="col-md">
            <h4>Item</h4>
            <partial name="_ItemDetailsPartial" model="@Model.Item"/>
            @Html.HiddenFor(model => model.Item.Id)
            @Html.HiddenFor(model => model.Item.Price)
            @Html.HiddenFor(model => model.Item.ShouldBeShown)
            @Html.HiddenFor(model => model.Item.CategoryId)
            @Html.HiddenFor(model => model.Item.Name)
            @Html.HiddenFor(model => model.Item!.Image!.Id)
            @Html.HiddenFor(model => model.Item!.Image!.AltDescription)
            @Html.HiddenFor(model => model.Item!.Image!.FileUrl)
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-4">
            <div class="row align-items-center">
                <div class="col-md">
                    <div class="form-floating">
                        <input asp-for="ItemsAmount" class="form-control" oninput="calculateTotal()" type="number"
                               min="0"/>
                        <label asp-for="ItemsAmount">Quantity</label>
                        <span asp-validation-for="ItemsAmount" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md">
                    <div class="form-floating">
                        <input asp-for="PricePerItem" class="form-control" oninput="calculateTotal()" type="number"
                               step="0.01" min="0"/>
                        <label asp-for="PricePerItem">Price per pcs</label>
                        <span asp-validation-for="PricePerItem" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md">
                    <div class="form-floating">
                        <input id="total" class="form-control" readonly value="0"/>
                        <label for="total">Total</label>
                    </div>
                </div>
                <div class="col-md">
                    <input type="submit" value="Add" class="btn btn-primary"/>
                </div>
            </div>

        </div>
    </div>
</form>

@section Scripts
{
    <script type="text/javascript">
    function calculateTotal() {
        var pricePerItem = parseFloat(document.getElementById("@Html.IdFor(x => x.PricePerItem)").value);
        var quantity = parseFloat(document.getElementById("@Html.IdFor(x => x.ItemsAmount)").value);
        var total = 0;

        if (!isNaN(pricePerItem) && pricePerItem >= 0 && !isNaN(quantity) && quantity >= 0) {
            total = pricePerItem * quantity;
        } else {
            total = NaN;
        }

        document.getElementById("total").value = total.toFixed(2);
    }
</script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}