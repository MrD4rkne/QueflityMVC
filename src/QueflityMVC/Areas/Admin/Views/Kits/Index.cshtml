@inject IAuthorizationService AuthorizationService
@using Microsoft.AspNetCore.Authorization
@using QueflityMVC.Application.Constants
@model QueflityMVC.Application.ViewModels.Kit.ListKitsVm

@{
    ViewData["Title"] = "Index";
    int[] options = { 2, 5, 10, 25, 50, 100 };
    bool canCreateEntities = (await AuthorizationService.AuthorizeAsync(User, Policies.ENTITIES_CREATE)).Succeeded;
    bool canEditEntities = (await AuthorizationService.AuthorizeAsync(User, Policies.ENTITIES_EDIT)).Succeeded;
    bool canListEntities = (await AuthorizationService.AuthorizeAsync(User, Policies.ENTITIES_LIST)).Succeeded;
}

<div class="container-fluid p-4">
    <h1 class="mb-4">
        <i class="fas fa-boxes"></i> Kits
    </h1>

    @if (canCreateEntities)
    {
        <p>
            <a class="btn btn-primary" asp-action="Create" asp-controller="Kits" asp-area="Admin">
                <i class="fas fa-plus-circle"></i> Create New
            </a>
        </p>
    }

    <form asp-action="Index" asp-controller="Kits" asp-area="Admin" method="post"
          data-filter-info="@Model.Pagination.Info">
        @if (Model.ItemId.HasValue)
        {
            <div class="alert alert-info fade show mb-3" role="alert">
                <strong>Item Filter Applied:</strong> Currently, you see kits that include item with ID @Model.ItemId as a
                part of them.
                <button type="button" class="btn btn-outline-primary" aria-label="Close" onclick="RemoveItemFilter()">
                    Clear Filter
                </button>
            </div>
        }


        <div class="row align-items-center mb-3">
            <!-- Search Input -->
            <div class="col-md-4 mb-2 mb-md-0">
                <div class="input-group">
                    <span class="input-group-text bg-primary text-white">
                        <i class="fas fa-search"></i>
                    </span>
                    <input type="text" class="form-control" placeholder="Search..." asp-for="NameFilter"
                           id="nameFilter"/>
                </div>
            </div>
            <!-- Search Button -->
            <div class="col-md-2 mb-2 mb-md-0">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-filter"></i> Search
                </button>
            </div>
            <!-- Page Size Selector -->
            <div class="col-md-3">
                <div class="input-group">
                    <label class="input-group-text bg-primary text-white" for="pageSizeSelect">
                        <i class="fas fa-list"></i>
                    </label>
                    <select class="form-select" asp-for="Pagination.Info.PageSize" id="pageSizeSelect"
                            onchange="PageSizeSelected()">
                        @foreach (int i in options)
                        {
                            if (i == Model.Pagination.Info.PageSize)
                            {
                                <option value="@i" selected>@i</option>
                            }
                            else
                            {
                                <option value="@i">@i</option>
                            }
                        }
                    </select>
                </div>
            </div>
        </div>

        <div class="row">
            @if (Model.Pagination.Entities != null && Model.Pagination.Entities.Count > 0)
            {
                <table class="table table-striped">
                    <thead>
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Visibility</th>
                        <th>Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Pagination.Entities)
                    {
                        <tr>
                            <td>
                                @if (item.Image != null)
                                {
                                    <img src="@item.Image.FileUrl" alt="@item.Image.AltDescription" style="height:30px"/>
                                }
                            </td>
                            <td>@Html.DisplayFor(modelItem => item.Name)</td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Price)
                            </td>
                            <td>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" @(item.ShouldBeShown ? "checked" : "")
                                           disabled/>
                                    <label class="form-check-label">@(item.ShouldBeShown ? "Visible" : "Hidden")</label>
                                </div>
                            </td>
                            <td>
                                <div class="btn-group" role="group" aria-label="Manage kit">
                                    @if (canEditEntities)
                                    {
                                        @Html.ActionLink("Edit", "Edit", "Kits", new { area = "Admin", id = item.Id }, new { @class = "btn btn-outline-secondary btn-sm" })
                                    }
                                    @if (canListEntities)
                                    {
                                        @Html.ActionLink("Details", "Details", "Kits", new { area = "Admin", id = item.Id }, new { @class = "btn btn-outline-success btn-sm" })
                                    }
                                    @if (canCreateEntities)
                                    {
                                        @Html.ActionLink("Delete", "Delete", "Kits", new { area = "Admin", id = item.Id }, new { @class = "btn btn-outline-danger btn-sm" })
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-info" role="alert">
                    <i class="fas fa-info-circle"></i> Sorry! Nothing to be shown here.
                </div>
            }
        </div>

        @Html.HiddenFor(model => model.ItemId)

        <div class="row">
            <partial name="_PaginationPartial" for="Pagination.Info"/>
        </div>
    </form>
</div>

@section Scripts {
    <script type="text/javascript">
    function PageSizeSelected() {
        SubmitPagination();
    }

    function RemoveItemFilter() {
        document.getElementById("@Html.IdFor(x => x.ItemId)").value = "";
        SubmitPagination();
    }

    function SubmitPagination() {
        // Assuming this function submits the form or reloads the page with updated pagination settings.
        document.querySelector('form').submit();
    }
</script>
}