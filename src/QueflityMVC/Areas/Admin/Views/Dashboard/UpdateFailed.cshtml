@model QueflityMVC.Application.ViewModels.Product.UpdateOrderFailedVm

@{
    ViewData["Title"] = "Update failed";
}

<h1>Updating Order Failed</h1>

<div class="container mt-4">
    <!-- Alert box for error message -->
    <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading">Error!</h4>
        <p>@Model.Message</p>
        <hr/>
        <p class="mb-0">
            <a class="btn btn-primary" href="@Url.Action("Index", "Dashboard", new { area = "Admin" })">Retry</a> |
            <a class="btn btn-secondary" href="@Url.Action("Index", "Home", new { area = "Admin" })">
                Back to Admin
                Panel
            </a>
        </p>
    </div>
</div>