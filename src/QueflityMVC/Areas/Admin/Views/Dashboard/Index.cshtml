@using Microsoft.AspNetCore.Mvc.TagHelpers
@using QueflityMVC.Application.ViewModels.Product
@model QueflityMVC.Application.ViewModels.Product.EditOrderVm

@{
    ViewData["Title"] = "Dashboard";
}

@section Styles {
    <style>
        table {
            font-family: Arial, sans-serif;
            border-collapse: collapse;
            width: 100%;
        }

        th, td {
            border: 1px solid #ddd;
            text-align: left;
            padding: 8px;
        }

        tr:nth-child(even) {
            background-color: #f2f2f2;
        }

        tr:hover {
            background-color: #d1ecf1;
            color: #000;
        }

        .ui-sortable-placeholder td {
            background-color: #e9ecef;
            border: 1px dashed #ced4da;
        }

        .badge-primary {
            background-color: #0d6efd;
            color: #fff;
        }

        .badge-secondary {
            background-color: #6c757d;
            color: #fff;
        }
    </style>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://ajax.googleapis.com/ajax/libs/jqueryui/1.13.2/themes/smoothness/jquery-ui.css">
}

<div class="container-fluid p-4">
    <form asp-action="Index" asp-controller="Dashboard" asp-area="Admin">
        <div class="form-group mb-3">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Save the order
            </button>
        </div>
        <div class="table-responsive">
            <table class="table" id="table-1">
                <thead>
                <tr>
                    <th></th>
                    <th>ON</th>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Type</th>
                </tr>
                </thead>
                <tbody>
                @for (var i = 1; i <= Model.ProductsVMs.Count; i++)
                {
                    var currentEntity = Model.ProductsVMs[i - 1];
                    <tr id="@i">
                        @Html.HiddenFor(model => model.ProductsVMs[i - 1].Id)
                        @Html.HiddenFor(model => model.ProductsVMs[i - 1].Type)
                        @Html.HiddenFor(model => model.ProductsVMs[i - 1].OrderNo)
                        @Html.HiddenFor(model => model.ProductsVMs[i - 1].Image.FileUrl)
                        @Html.HiddenFor(model => model.ProductsVMs[i - 1].Image.AltDescription)
                        @Html.HiddenFor(model => model.ProductsVMs[i - 1].Price)
                        @Html.HiddenFor(model => model.ProductsVMs[i - 1].Name)
                        <td>
                            <img src="@currentEntity.Image.FileUrl" alt="@currentEntity.Image.AltDescription"
                                 style="height:30px;"/>
                        </td>
                        <td>@currentEntity.OrderNo</td>
                        <td>@currentEntity.Name</td>
                        <td>@currentEntity.Price</td>
                        <td>
                            @switch (currentEntity.Type)
                            {
                                case ProductType.Item:
                                    <span class="badge badge-primary">Item</span>
                                    break;
                                case ProductType.Kit:
                                    <span class="badge badge-secondary">Kit</span>
                                    break;
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.1/jquery.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.13.2/jquery-ui.min.js"></script>
    <script type="text/javascript">
        $(function () {
            $("#table-1 tbody").sortable({
                items: 'tr',
                placeholder: "ui-sortable-placeholder",
                stop(e, ui) {
                    $(this).find("tr").each(function (index) {
                        $(this).find("input").eq(2).val(index);
                    });
                }
            });
        });

        $(document).ready(function () {
        var maxWidth = 0;
        $('#table-1 td:nth-child(3)').each(function () {
            if (maxWidth < $(this).width()) {
                maxWidth = $(this).width();
            }
        });
        $('#table-1 td:nth-child(3)').css('width', maxWidth);
        });
    </script>
}