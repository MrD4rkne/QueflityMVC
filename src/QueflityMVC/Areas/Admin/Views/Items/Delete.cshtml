@using Microsoft.AspNetCore.Mvc.TagHelpers
@model QueflityMVC.Application.ViewModels.Item.DeleteFailedItemVm

@{
    ViewData["Title"] = "Deletion failed";
}

<h1>Delete</h1>

<div>
    <h4>@Model.Message</h4>
    <hr/>
</div>
<div>
    @Html.ActionLink("View kits with this item", "Index", "Kits", new { area = "Admin", itemId = Model.ItemId }) |
    <a asp-action="Index" asp-controller="Items" asp-area="Admin">Back to List</a>
</div>