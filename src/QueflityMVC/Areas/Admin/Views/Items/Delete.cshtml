@using Microsoft.AspNetCore.Mvc.TagHelpers
@model QueflityMVC.Application.ViewModels.Item.DeleteFailedItemVm

@{
    ViewData["Title"] = "Deletion Failed";
}

<div class="container mt-4">
    <div class="alert alert-danger">
        <h4 class="alert-heading">
            <i class="fa fa-exclamation-triangle"></i> Deletion Failed
        </h4>
        <p>@Model.Message</p>
    </div>

    <div class="mt-4">
        <a asp-action="Index" asp-controller="Kits" asp-area="Admin" class="btn btn-info">
            <i class="fa fa-box"></i> View Kits with this Item
        </a>
        <a asp-action="Index" asp-controller="Items" asp-area="Admin" class="btn btn-secondary ms-2">
            <i class="fa fa-arrow-left"></i> Back to List
        </a>
    </div>
</div>