@inject IAuthorizationService AuthorizationService
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using QueflityMVC.Application.Constants
@model QueflityMVC.Application.ViewModels.Item.ItemComponentsSelectionVm

@{
    ViewData["Title"] = "Components";
    bool canListEntities = (await AuthorizationService.AuthorizeAsync(User, Policies.ENTITIES_LIST)).Succeeded;
    bool canEditEntities = (await AuthorizationService.AuthorizeAsync(User, Policies.ENTITIES_EDIT)).Succeeded;
}


@section Styles{
    <style>
    .card-img-top {
        height: 180px;
        object-fit: cover;
    }

    .btn-custom {
        margin-right: 5px;
    }

    .form-check-input {
        margin-right: 10px;
    }

    .table th {
        width: 200px;
    }

    .table td {
        vertical-align: middle;
    }

    .btn-icon {
        margin-right: 5px;
    }
</style>
}

<div class="container mt-4">
    @if (canListEntities)
    {
        <div class="mb-4">
            <a asp-action="Index" asp-controller="Items" asp-area="Admin" class="btn btn-info">
                <i class="fa fa-arrow-left"></i> Back to List
            </a>
        </div>
    }
    <form asp-action="Components" asp-controller="Items" asp-area="Admin" enctype="multipart/form-data">
        <h1><i class="fa fa-cogs"></i> Item Components</h1>
        <input type="hidden" asp-for="Item.Id"/>

        <div class="card mb-4" style="width: 18rem;">
            @if (Model.Item.Image != null && !string.IsNullOrEmpty(Model.Item.Image.FileUrl))
            {
                <img src="@Model.Item.Image.FileUrl" class="card-img-top" alt="@Model.Item.Image.AltDescription">
            }
            else
            {
                <img src="https://via.placeholder.com/150" class="card-img-top" alt="No image available">
            }
            <div class="card-body">
                <h5 class="card-title">@Model.Item.Name</h5>
                @if (canEditEntities)
                {
                    <a href="@Url.Action("Edit", "Items", new { id = Model.Item.Id, area = "Admin" })"
                       class="btn btn-primary btn-icon">
                        <i class="fa fa-pencil-alt"></i> Edit Item
                    </a>
                }
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-auto">
                <h2><i class="fa fa-list"></i> Components</h2>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary btn-lg btn-custom">
                    <i class="fa fa-save"></i> Save Components
                </button>
            </div>
        </div>

        <table class="table">
            <thead>
            <tr>
                <th scope="col"><i class="fa fa-check-square"></i> Does item contain</th>
                <th scope="col"><i class="fa fa-tag"></i> Name</th>
            </tr>
            </thead>
            <tbody>
            @for (var i = 0; i < Model.AllComponents.Count; i++)
            {
                var item = Model.AllComponents[i];
                <tr>
                    <td>
                        <input class="form-check-input" asp-for="AllComponents[i].IsSelected" type="checkbox"
                               checked="@(Model.SelectedComponentsIds.Contains(item.Id) ? "checked" : null)">
                        <input type="hidden" asp-for="AllComponents[i].Id" value="@item.Id"/>
                        <input type="hidden" asp-for="AllComponents[i].Name" value="@item.Name"/>
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </form>
</div>