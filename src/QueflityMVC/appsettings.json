{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Brand": {
    "Name": "Queflity",
    "LogoUrl": "/favicon.ico",
    "IdentityPage": {
      "Header": "Welcome to Queflity",
      "Subheader": "Yours truly",
      "BackgroundImageUrl": "https://media.porsche.com/mediakit/911-gts/01-photos/01-01-porsche-911-gts-models/image-thumb__29531__mk2-modal-item/P21_0182_a3_rgb.jpg"
    }
  },
  "Smtp": {
    "Host": "your.smtp.host",
    "Port": 2525,
    "Username": "queflity",
    "Password": "your_password",
    "Email": "queflity@mvc",
    "Name": "Queflity"
  },
  "Emails": {
    "QuestionAskedOptions": {
      "Subject": "New question asked",
      "Body": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Confirmation of Question Asked</title>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            color: #333;\n            line-height: 1.6;\n            margin: 0;\n            padding: 0;\n            background-color: #f4f4f4;\n        }\n        .container {\n            width: 80%;\n            margin: auto;\n            background: #fff;\n            padding: 20px;\n            border: 1px solid #ddd;\n            border-radius: 5px;\n        }\n        h1 {\n            color: #333;\n        }\n        .footer {\n            margin-top: 20px;\n            font-size: 0.9em;\n            color: #777;\n        }\n        .highlight {\n            background-color: #f9f9f9;\n            padding: 10px;\n            border-left: 5px solid #007bff;\n            margin: 10px 0;\n        }\n        .button {\n            display: inline-block;\n            padding: 10px 15px;\n            color: #fff;\n            background-color: #007bff;\n            text-decoration: none;\n            border-radius: 5px;\n        }\n        .button:hover {\n            background-color: #0056b3;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <h1>Confirmation of Your Question</h1>\n        <p>Hi <strong>{userName}</strong>,</p>\n        <p>Thank you for reaching out to us! We have received your question and it has been added to our system. Below are the details of your inquiry:</p>\n        \n        <div class=\"highlight\">\n            <h2>{conversationTitle}</h2>\n            <p>{messageContent}</p>\n        </div>\n        \n        <p><strong>Sent at:</strong> {sentAt}</p>\n        \n        <p>If you need further assistance or have additional questions, please visit our page and head to your Conversations page</a> rather than replying to this email.</p>\n        \n        <p>Best regards,</p>\n        <p>Your Support Team</p>\n    </div>\n</body>\n</html>\n"
    },
    "EmailConfirmationOptions": {
      "Subject": "Email Confirmation",
      "Body": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Email Confirmation</title>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            color: #333;\n            line-height: 1.6;\n            margin: 0;\n            padding: 0;\n            background-color: #f4f4f4;\n        }\n        .container {\n            width: 80%;\n            margin: auto;\n            background: #fff;\n            padding: 20px;\n            border: 1px solid #ddd;\n            border-radius: 5px;\n        }\n        h1 {\n            color: #333;\n        }\n        .button {\n            display: inline-block;\n            padding: 10px 15px;\n            color: #fff;\n            background-color: #007bff;\n            text-decoration: none;\n            border-radius: 5px;\n        }\n        .button:hover {\n            background-color: #0056b3;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <h1>Email Confirmation Required</h1>\n        <p>Hi <strong>{userName}</strong>,</p>\n        <p>To confirm your email address, please click the link below:</p>\n        \n        <p><a href=\"{confirmationLink}\" class=\"button\">Confirm Your Email</a></p>\n        \n        <p>If you did not request this, please ignore this email.</p>\n        \n        <p>Best regards,</p>\n        <p>Your Team</p>\n    </div>\n</body>\n</html>\n"
    },
    "PasswordResetOptions": {
      "Subject": "Password Reset",
      "Body": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Password Reset Request</title>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            color: #333;\n            line-height: 1.6;\n            margin: 0;\n            padding: 0;\n            background-color: #f4f4f4;\n        }\n        .container {\n            width: 80%;\n            margin: auto;\n            background: #fff;\n            padding: 20px;\n            border: 1px solid #ddd;\n            border-radius: 5px;\n        }\n        h1 {\n            color: #333;\n        }\n        .button {\n            display: inline-block;\n            padding: 10px 15px;\n            color: #fff;\n            background-color: #007bff;\n            text-decoration: none;\n            border-radius: 5px;\n        }\n        .button:hover {\n            background-color: #0056b3;\n        }\n        .footer {\n            margin-top: 20px;\n            font-size: 0.9em;\n            color: #777;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <h1>Password Reset Request</h1>\n        <p>Hi <strong>{userName}</strong>,</p>\n        <p>We received a request to reset the password for your account associated with the email address <strong>{email}</strong>.</p>\n        <p>If you made this request, please click the button below to reset your password:</p>\n        \n        <p><a href=\"{resetLink}\" class=\"button\">Reset Password</a></p>\n        \n        <p>If you did not request a password reset, please ignore this email. Your password will not be changed.</p>\n        \n        <p>Best regards,</p>\n        <p>Your Team</p>\n    </div>\n</body>\n</html>\n"
    }
  },
  "Database": {
    "ConnectionString": "Server=localhost\\MSSQLSERVER;Database=queflity;Integrated Security=true;MultipleActiveResultSets=true;TrustServerCertificate=true",
    "ShouldRetry": true
  },
  "Jobs": {
    "UseDatabase": false,
    "MaxConcurrency": 20
  },
  "GoogleOAuth": {
    "ClientId": "client_id.apps.googleusercontent.com",
    "ClientSecret": "client_secret"
  }
}